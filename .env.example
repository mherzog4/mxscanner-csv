RESEND_API_KEY=re_...

# Sending identity. Both default to the gtmreports.com values below when unset,
# so the domain only needs to be verified once in Resend.
EMAIL_FROM="MX SEG Scanner <reports@gtmreports.com>"
EMAIL_REPLY_TO="matt@gtmreports.com"

NEXT_PUBLIC_GITHUB_URL="https://github.com/your-org/mxscanner-csv"

# Optional: Resend audience to store delivery emails as contacts (lead capture).
RESEND_AUDIENCE_ID=

# Optional: durable rate limiting via Upstash Redis (auto-injected by the
# Vercel Marketplace integration). Falls back to in-memory limiting if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
